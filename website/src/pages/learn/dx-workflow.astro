---
import SidebarLayout from '../../layouts/SidebarLayout.astro';
import styles from './_dx-workflow/styles.css?raw';
import body from './_dx-workflow/body.html?raw';
import script from './_dx-workflow/script.js?raw';
---

<SidebarLayout
  title="dx Workflow"
  sidebar="learn"
  description="Interactive diagram of the dx skill pipeline — from ADO/Jira ticket to merged PR, with subagent delegation, multi-repo hops, and config overrides."
>
  <style is:inline set:html={styles}></style>
  <div class="dxw-scope" set:html={body}></div>
  <script is:inline set:html={script}></script>
</SidebarLayout>
