{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.sh\"",
            "statusMessage": "Validating environment..."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/context-loader.sh\"",
            "statusMessage": "Loading ticket context..."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/next-step.sh\"",
            "statusMessage": "Checking workflow state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|bash|shell|execute",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash -c 'grep -q \"git commit\" || exit 0; BRANCH=$(git branch --show-current 2>/dev/null); if [ \"$BRANCH\" = \"main\" ] || [ \"$BRANCH\" = \"master\" ] || [ \"$BRANCH\" = \"development\" ] || [ \"$BRANCH\" = \"develop\" ]; then echo \"BLOCKED: Do not commit on $BRANCH. Create a feature/* or bugfix/* branch first.\" >&2; exit 2; fi'",
            "statusMessage": "Checking branch protection...",
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/project-hook.sh\" .claude/hooks/stop-guard.sh",
            "statusMessage": "Running completion checks..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_dx-core_figma__get_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/project-hook.sh\" .ai/lib/figma-screenshot-hook.sh",
            "statusMessage": "Saving Figma screenshot..."
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dx-core_figma__get_design_context",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/project-hook.sh\" .ai/lib/figma-screenshot-hook.sh",
            "statusMessage": "Saving Figma design context..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/.claude-plugin/**)",
            "command": "f=\"$(sed -n 's/.*\"file_path\" *: *\"\\([^\"]*\\)\".*/\\1/p' | head -1)\"; if [ -n \"$f\" ]; then bash \"${CLAUDE_PLUGIN_ROOT}/data/lib/validate-plugin-edit.sh\" \"$f\"; fi",
            "statusMessage": "Validating plugin edit..."
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; mkdir -p \"$D/.claude\" && echo \"[$(date '+%H:%M:%S')] Subagent completed\" >> \"$D/.claude/subagent-log.txt\" || true",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/compaction-reminder.sh\"",
            "async": true
          }
        ]
      }
    ]
  }
}
