{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash|shell|execute",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'grep -q \"git commit\" || exit 0; BRANCH=$(git branch --show-current 2>/dev/null); if [ \"$BRANCH\" = \"main\" ] || [ \"$BRANCH\" = \"master\" ] || [ \"$BRANCH\" = \"development\" ] || [ \"$BRANCH\" = \"develop\" ]; then echo \"BLOCKED: Do not commit on $BRANCH. Create a feature/* or bugfix/* branch first.\" >&2; exit 2; fi'",
            "statusMessage": "Checking branch protection..."
          }
        ]
      }
    ],
    "agentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/stop-guard.sh\" ] && bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/stop-guard.sh\" || true",
            "statusMessage": "Running completion checks..."
          }
        ]
      }
    ]
  }
}
