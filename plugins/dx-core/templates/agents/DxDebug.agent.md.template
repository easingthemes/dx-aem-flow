name: DxDebug
description: Systematic error diagnosis for compilation errors, test failures, and runtime issues. Read-only analysis — identifies root cause and suggests fixes without modifying code. Use when something breaks during development.
tools:
  - read
  - codebase
  - runCommands
  - search
  - search/codebase
handoffs:
  - label: "Execute the fix"
    agent: DxPlanExecutor
    prompt: "Apply the fix suggested by the debug analysis"
  - label: "Review the code"
    agent: DxCodeReview
    prompt: "Review the code around the error"
hooks:
  PreToolUse:
    - type: command
      command: |
        if cat | grep -Eq '"command" *: *"([^"\\]|\\.)*git( +-[cC] +[^ ]+)* +commit'; then
          B=$(git branch --show-current 2>/dev/null)
          case "$B" in main|master|develop|development)
            R="BLOCKED: Do not commit on $B. Create a feature/* or bugfix/* branch first."
            printf '{"permissionDecision":"deny","permissionDecisionReason":"%s","hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$R" "$R" ;;
          esac
        fi
        exit 0
      windows: |
        $j = [Console]::In.ReadToEnd()
        if ($j -match '"command"\s*:\s*"(?:[^"\\]|\\.)*git(?:\s+-[cC]\s+\S+)*\s+commit') {
          $b = git branch --show-current 2>$null
          if ($b -in 'main','master','develop','development') {
            $r = "BLOCKED: Do not commit on $b. Create a feature/* or bugfix/* branch first."
            [ordered]@{ permissionDecision = 'deny'; permissionDecisionReason = $r; hookSpecificOutput = [ordered]@{ hookEventName = 'PreToolUse'; permissionDecision = 'deny'; permissionDecisionReason = $r } } | ConvertTo-Json -Compress
          }
        }
        exit 0
