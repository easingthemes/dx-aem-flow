{
  "mcpServers": {
    "AEM": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "aem-mcp-server", "-t", "stdio", "-I", "${AEM_INSTANCES}"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--viewport-size=1440,900",
        "--caps=storage",
        "--no-webmcp",
        "--output-dir=.ai/playwright/screenshots"
      ]
    }
  }
}
