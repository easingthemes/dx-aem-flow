{
  "version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_dx-aem_playwright__browser_take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/screenshot-log.sh\"",
            "async": true,
            "statusMessage": "Logging screenshot..."
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dx-aem_playwright__browser_snapshot",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/screenshot-log.sh\"",
            "async": true,
            "statusMessage": "Logging snapshot..."
          }
        ]
      }
    ]
  }
}
